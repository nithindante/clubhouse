<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - ClubHouse</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Instrument+Sans:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="/css/style.css" />
</head>

<body>
    <div class="door">
        <nav class="navbar" aria-label="Main">
            <a class="navbar-brand" href="/">Club house</a>
            <div class="navbar-links">
                <a class="navbar-link" href="/dashboard" aria-current="page">Dashboard</a>
                <a class="navbar-link" href="/my-message">My message</a>
                <a class="navbar-link" href="/create-message">Create a message</a>
                <a class="navbar-link" href="/new-member">Become a member</a>
                <a class="navbar-link" href="/admin">Admin</a>
                <form method="POST" action="/logout">
                    <button class="btn btn-secondary">Log out</button>
                </form>
                
            </div>
        </nav>
        <header class="placard">
            <h1>Club house</h1>
        </header>
        <main class="mainDiv">
            <p class="notice">Welcome<%= locals.user && user.full_name ? ", " + user.full_name : "" %>. The doors are
                    open — messages from the club will appear here.</p>
            <section class="messages" aria-labelledby="messages-heading">
                <h2 class="messages-title" id="messages-heading">Latest messages</h2>
                <% if (locals.messages && messages.length) { %>
                    <% messages.forEach(message => { %>
                        <article class="message-card">
                            <div>
                            <% if (message.title) { %>
                                <h3 class="message-title"><%= isMember ? message.title : "********* " %></h3>
                            <% } %>
                            <p class="message-text"><%= message.text %></p>
                            <% if (message.time_stamp) { %>
                                <time class="message-time" datetime="<%= new Date(message.time_stamp).toISOString() %>"><%= isMember ? new Date(message.time_stamp).toLocaleString() : '******************' %></time>
                            <% } %>
                            </div>
                            <div>
                            <% if(isAdmin) {%>
                                <form class="message-actions" method="POST" action="/dashboard/delete-message/<%= message.id %>">
                                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                </form>
                                <%  }%>
                                </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <p class="signup-intro">No messages yet. Be the first to post.</p>
                <% } %>
            </section>
        </main>

    </div>
    <% if (errors) { %>
        <script>
            window.addEventListener("load", () => {
                const error = '<%- JSON.stringify(errors) %>';
                window.alert(error)
            })
        </script>
        <% } %>
</body>

</html>